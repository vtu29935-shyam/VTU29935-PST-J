import java.util.*;

public class Solution {

    public static List<Integer> maxSubarray(List<Integer> arr) {

        int maxSubarray = arr.get(0);
        int current = arr.get(0);

        int maxSubsequence = arr.get(0);
        int maxElement = arr.get(0);

        for (int i = 1; i < arr.size(); i++) {

            // Maximum subarray sum (Kadane's Algorithm)
            current = Math.max(arr.get(i), current + arr.get(i));
            maxSubarray = Math.max(maxSubarray, current);

            // Maximum subsequence sum
            if (arr.get(i) > 0) {
                maxSubsequence += arr.get(i);
            }

            // Largest element (needed when all numbers are negative)
            maxElement = Math.max(maxElement, arr.get(i));
        }

        // If all elements are negative
        if (maxSubsequence <= 0) {
            maxSubsequence = maxElement;
        }

        List<Integer> result = new ArrayList<>();
        result.add(maxSubarray);
        result.add(maxSubsequence);

        return result;
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int t = sc.nextInt();

        while (t-- > 0) {

            int n = sc.nextInt();

            List<Integer> arr = new ArrayList<>();

            for (int i = 0; i < n; i++) {
                arr.add(sc.nextInt());
            }

            List<Integer> result = maxSubarray(arr);

            System.out.println(result.get(0) + " " + result.get(1));
        }

        sc.close();
    }
}
